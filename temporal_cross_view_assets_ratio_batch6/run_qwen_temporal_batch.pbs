#!/bin/bash
#PBS -P personal-gwang016
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=04:00:00
#PBS -N qwen4b_temporal_batch6
#PBS -j oe

set -euo pipefail

REPO="$HOME/worldmodel/sam3"
RUNNER_DIR="$REPO/temporal_cross_view_assets_ratio_batch6"
ASSETS="${ASSETS:-$RUNNER_DIR}"
SCRATCH="/scratch/users/ntu/$USER"
PYTHON="$HOME/.conda/envs/sam3/bin/python"
MODEL_DIR="$SCRATCH/qwen35-4b/model"
WORK_DIR="${WORK_DIR:-$SCRATCH/qwen35-4b/temporal_batch6_work_v2}"

cd "$RUNNER_DIR"

echo "host=$(hostname)"
echo "job_id=${PBS_JOBID:-unknown}"
echo "python=$PYTHON"
echo "model=$MODEL_DIR"
echo "assets=$ASSETS"
echo "work_dir=$WORK_DIR"
test -x "$PYTHON"
test -f "$MODEL_DIR/config.json"
nvidia-smi

ARGS=(
  --assets-root "$ASSETS"
  --model "$MODEL_DIR"
  --work-dir "$WORK_DIR"
)
if [[ -n "${CASE_FILTER:-}" ]]; then
  echo "case_filter=$CASE_FILTER"
  ARGS+=(--case "$CASE_FILTER")
fi
if [[ -n "${SUMMARY_PATH:-}" ]]; then
  echo "summary_path=$SUMMARY_PATH"
  ARGS+=(--summary-path "$SUMMARY_PATH")
fi

"$PYTHON" "$RUNNER_DIR/qwen_temporal_runner.py" "${ARGS[@]}"
