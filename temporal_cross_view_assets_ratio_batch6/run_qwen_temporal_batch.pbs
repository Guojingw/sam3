#!/bin/bash
#PBS -P personal-gwang016
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=04:00:00
#PBS -N qwen4b_temporal_batch6
#PBS -j oe

set -euo pipefail

REPO="$HOME/worldmodel/sam3"
ASSETS="$REPO/temporal_cross_view_assets_ratio_batch6"
SCRATCH="/scratch/users/ntu/$USER"
PYTHON="$HOME/.conda/envs/sam3/bin/python"
MODEL_DIR="$SCRATCH/qwen35-4b/model"
WORK_DIR="$SCRATCH/qwen35-4b/temporal_batch6_work_v2"

cd "$ASSETS"

echo "host=$(hostname)"
echo "job_id=${PBS_JOBID:-unknown}"
echo "python=$PYTHON"
echo "model=$MODEL_DIR"
test -x "$PYTHON"
test -f "$MODEL_DIR/config.json"
nvidia-smi

"$PYTHON" qwen_temporal_runner.py \
  --assets-root "$ASSETS" \
  --model "$MODEL_DIR" \
  --work-dir "$WORK_DIR"
